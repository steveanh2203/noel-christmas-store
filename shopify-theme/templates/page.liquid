<div class="page-header-banner">
  <div class="container">
    <div class="breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a> <span>/</span> <span>{{ page.title }}</span>
    </div>
    <h1 class="page-title">{{ page.title }}</h1>
  </div>
</div>

<div class="container" style="max-width: 960px; margin: 48px auto 80px; padding: 0 20px; line-height: 1.8; color: var(--color-text-main);">
  <div class="rte" style="background: #ffffff; border: 1px solid var(--color-border); border-radius: 8px; padding: 40px;">
    {{ page.content }}
  </div>
</div>
