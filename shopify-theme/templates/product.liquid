<div class="container" style="padding: 48px 0;">
  <div class="pdp-layout">
    <!-- Gallery -->
    <div class="pdp-gallery">
      <div class="pdp-main-image">
        <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
      </div>
      
      <div class="pdp-gallery-highlights">
        <div class="gallery-highlights-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          <span>Artisanal Craftsmanship &amp; Highlights</span>
        </div>
        <ul class="gallery-highlights-list">
          <li class="gallery-highlight-item"><span class="highlight-check">✓</span><span>100% Natural Organic Materials &amp; Eco-Certified</span></li>
          <li class="gallery-highlight-item"><span class="highlight-check">✓</span><span>Handcrafted &amp; Hand-Poured in Small Artisan Batches</span></li>
          <li class="gallery-highlight-item"><span class="highlight-check">✓</span><span>Deluxe Keepsake Packaging with Velvet Satin Ribbon</span></li>
          <li class="gallery-highlight-item"><span class="highlight-check">✓</span><span>Passed-Down Family Heirloom Longevity</span></li>
        </ul>
      </div>

      <div class="pdp-gallery-guarantee">
        <div class="gallery-guarantee-grid">
          <div class="guarantee-badge-item"><div class="guarantee-icon">🎁</div><div class="guarantee-text"><strong>Signature Gift Box</strong><span>Ribbon &amp; card ready</span></div></div>
          <div class="guarantee-badge-item"><div class="guarantee-icon">🚚</div><div class="guarantee-text"><strong>Pre-Dec 24 Express</strong><span>Guaranteed delivery</span></div></div>
          <div class="guarantee-badge-item"><div class="guarantee-icon">🛡️</div><div class="guarantee-text"><strong>Extended Returns</strong><span>Until Jan 31, 2025</span></div></div>
          <div class="guarantee-badge-item"><div class="guarantee-icon">✨</div><div class="guarantee-text"><strong>Artisan Guarantee</strong><span>100% Happiness pledge</span></div></div>
        </div>
      </div>
    </div>

    <!-- Product Details & CRO Conversion Suite -->
    <div class="pdp-info">
      <!-- Live Social Proof -->
      <div class="live-viewers-badge">
        <span class="live-pulse-dot"></span>
        <span><strong>28</strong> holiday shoppers are viewing this right now</span>
      </div>

      <h1 class="pdp-title">{{ product.title }}</h1>
      <div class="pdp-price-box">
        <span class="pdp-price-now">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="pdp-price-was">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <!-- Stock Urgency Meter -->
      <div class="stock-meter-box">
        <div class="stock-meter-header">
          <span>⚠️ Low Holiday Stock</span>
          <span style="color: var(--color-festive-red);">Selling Fast!</span>
        </div>
        <div class="stock-progress-track">
          <div class="stock-progress-bar" style="width: 35%;"></div>
        </div>
      </div>

      <!-- Delivery Estimator -->
      <div class="delivery-estimator-box">
        <div class="delivery-est-header">
          <span>🚚 Guaranteed Pre-Christmas Arrival</span>
          <span style="font-size: 0.78rem; background: #e8f5e9; color: #2e7d32; padding: 2px 8px; border-radius: 4px;">100% On-Time</span>
        </div>
        <p style="font-size: 0.84rem; margin: 0;">
          Order within <strong>03h 48m</strong> for guaranteed delivery before December 24 (USA &amp; EU).
        </p>
      </div>

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="pdp-actions-row" id="pdp-main-actions" style="margin-top: 20px;">
          <input type="number" name="quantity" value="1" min="1" class="qty-number" style="width: 50px; border: 1px solid #ccc; border-radius: 4px; padding: 10px;">
          <button type="submit" class="pdp-btn-add">Add to Holiday Bag 🎁</button>
        </div>
        {{ form | payment_button }}
      {% endform %}

      <div style="margin-top: 30px; line-height: 1.7; color: var(--color-text-muted);">
        {{ product.description }}
      </div>
    </div>
  </div>

  <!-- Frequently Bought Together Module -->
  <section class="fbt-section">
    <h3 class="fbt-title">Frequently Bought Together</h3>
    <p class="fbt-subtitle">Complete your holiday setup and save 15% on this curated holiday bundle</p>
    <div class="fbt-grid">
      <div class="fbt-products-row">
        <div class="fbt-item-card">
          <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}">
          <div>
            <strong>{{ product.title }}</strong>
            <div>{{ product.price | money }}</div>
          </div>
        </div>
      </div>
      <div class="fbt-summary-box">
        <span class="fbt-save-pill">🎁 Holiday Bundle Deal: Save 15%</span>
        <button class="btn btn-gold" style="width: 100%;">Add Bundle to Bag</button>
      </div>
    </div>
  </section>

  <!-- Mobile Sticky Add To Cart Bar -->
  <div class="mobile-sticky-atc" id="mobile-sticky-atc">
    <div style="display: flex; align-items: center; gap: 10px; overflow: hidden; max-width: 58%;">
      <img src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}" style="width: 42px; height: 42px; object-fit: cover; border-radius: 4px; flex-shrink: 0;">
      <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
        <div style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary-forest); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ product.title }}</div>
        <div style="font-size: 0.82rem; font-weight: 700; color: var(--color-festive-red);">{{ product.price | money }}</div>
      </div>
    </div>
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.88rem; white-space: nowrap; border-radius: 6px;">
        Add to Bag 🎁
      </button>
    {% endform %}
  </div>
</div>
