<section class="products-section" id="products-section">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.pretitle != blank -%}
        <span class="section-pretitle">{{ section.settings.pretitle }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: 'Curated Holiday Treasures' }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="section-description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="products-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <p style="text-align:center; grid-column:1/-1;">Please select a collection in the theme editor.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "pretitle",
      "label": "Section Subtitle",
      "default": "Curated Holiday Gift Guide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Thoughtfully Crafted For Everyone on Your List"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Find the perfect festive treasure with verified 5-star holiday reviews."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
