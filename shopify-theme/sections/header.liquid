<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Mobile Hamburger Button -->
    <button class="hamburger-btn" id="hamburger-btn" aria-label="Open navigation menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-brand">
      <div class="brand-logo-text">
        <span>{{ section.settings.logo_highlight | default: 'NOËL' }}</span> {{ section.settings.logo_suffix | default: '& CO.' }}
      </div>
    </a>

    <nav aria-label="Main Navigation">
      <ul class="site-nav">
        {%- for link in linklists[section.settings.menu].links -%}
          <li>
            <a href="{{ link.url }}" class="nav-link {% if link.current %}active{% endif %}">
              {{ link.title }}
            </a>
          </li>
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}" class="nav-link">Shop Catalog</a></li>
          <li><a href="/pages/gift-guide" class="nav-link">Gift Guide</a></li>
          <li><a href="/pages/shipping-policy" class="nav-link">Shipping Cutoffs</a></li>
          <li><a href="/pages/about" class="nav-link">Our Story</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="action-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>

      <button class="action-btn" id="cart-toggle-btn" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span class="cart-counter" id="cart-counter">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-overlay" id="mobile-nav-overlay"></div>
<aside class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation">
  <div class="mobile-nav-header">
    <div class="brand-logo-text" style="font-size:1.25rem;">
      <span>{{ section.settings.logo_highlight | default: 'NOËL' }}</span> {{ section.settings.logo_suffix | default: '& CO.' }}
    </div>
    <button id="close-mobile-nav-btn" style="font-size:1.2rem; color:var(--color-text-main); background:none; border:none; cursor:pointer;">✕</button>
  </div>
  <div class="mobile-nav-body">
    <ul class="mobile-nav-list">
      {%- for link in linklists[section.settings.menu].links -%}
        <li class="mobile-nav-item">
          <a href="{{ link.url }}" class="{% if link.current %}active{% endif %}">
            {{ link.title }} <span>→</span>
          </a>
        </li>
      {%- else -%}
        <li class="mobile-nav-item"><a href="{{ routes.root_url }}">Home Page <span>→</span></a></li>
        <li class="mobile-nav-item"><a href="{{ routes.all_products_collection_url }}">Shop All Holiday Items <span>→</span></a></li>
        <li class="mobile-nav-item"><a href="/pages/gift-guide">Official Gift Guide 2024 <span>→</span></a></li>
        <li class="mobile-nav-item"><a href="/pages/shipping-policy">Shipping Cutoff Dates <span>→</span></a></li>
        <li class="mobile-nav-item"><a href="/pages/returns-policy">Holiday Returns &amp; Exchanges <span>→</span></a></li>
        <li class="mobile-nav-item"><a href="/pages/track-order">Track Your Package 🚚 <span>→</span></a></li>
        <li class="mobile-nav-item"><a href="/pages/faq">FAQ &amp; Help Center <span>→</span></a></li>
        <li class="mobile-nav-item"><a href="/pages/contact">Contact Concierge <span>→</span></a></li>
      {%- endfor -%}
    </ul>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_highlight",
      "label": "Logo Prefix Highlight",
      "default": "NOËL"
    },
    {
      "type": "text",
      "id": "logo_suffix",
      "label": "Logo Suffix",
      "default": "& CO."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
