<section class="hero-section">
  <div class="hero-bg-wrapper">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero-bg-image', loading: 'eager' }}
    {%- else -%}
      <img src="{{ 'hero-banner.jpg' | asset_url }}" alt="Christmas Living Room" class="hero-bg-image">
    {%- endif -%}
  </div>
  <div class="hero-overlay"></div>

  <div class="container hero-content">
    {%- if section.settings.badge != blank -%}
      <span class="hero-badge">{{ section.settings.badge }}</span>
    {%- endif -%}

    <h1 class="hero-title">
      {{ section.settings.heading | default: 'Heirloom Gifts for <em>Magical</em> Christmas Evenings' }}
    </h1>

    <p class="hero-description">
      {{ section.settings.subheading | default: 'Meticulously hand-poured botanical candles, mouth-blown European glass ornaments, and Scandinavian merino wool throws.' }}
    </p>
    
    <div class="hero-buttons">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 }}" class="btn btn-gold">
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="btn btn-outline">
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>

    <div class="hero-perks">
      <div class="perk-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Free Express Shipping over {{ section.settings.free_shipping_threshold | default: '$75' }}</span>
      </div>
      <div class="perk-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Complimentary Holiday Gift Box</span>
      </div>
      <div class="perk-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Extended Returns to Jan 31</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Festive Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "The Holiday Collection 2024"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (HTML allowed)",
      "default": "Heirloom Gifts for <em>Magical</em> Christmas Evenings"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Description",
      "default": "Meticulously hand-poured botanical candles, mouth-blown European glass ornaments, and Scandinavian merino wool throws."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First Button Label",
      "default": "Shop Holiday Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second Button Label",
      "default": "Explore Holiday Gift Guide"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second Button Link"
    },
    {
      "type": "text",
      "id": "free_shipping_threshold",
      "label": "Free Shipping Threshold Display",
      "default": "$75 / €70"
    }
  ],
  "presets": [
    {
      "name": "Hero Festive Banner"
    }
  ]
}
{% endschema %}
